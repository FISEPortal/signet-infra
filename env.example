# =============================================================================
# Signet Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and configure for your environment.
# =============================================================================

# Domain Configuration
DOMAIN=signetapp.xyz

# SSL Certificate Paths (relative to nginx/ directory)
SSL_CERT_PATH=ssl/fullchain.pem
SSL_KEY_PATH=ssl/privkey.pem

# Application Ports (for reference - configured in nginx.conf)
# SIGNET_PORT=3000
# MARKETPLACE_PORT=3002
# TRUSTVAULT_PORT=3001

